<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>CodexResetBar</AssemblyName>
    <RootNamespace>CodexResetBar</RootNamespace>
    <Version>1.6.0</Version>
    <Product>Codex 额度提醒</Product>
    <Description>Windows tray monitor for locally signed-in Codex quota.</Description>
    <Copyright>Personal use; commercial use requires authorization.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexResetBar.Core/CodexResetBar.Core.csproj" />
    <EmbeddedResource Include="../../assets/wechat-qr.png" LogicalName="CodexResetBar.wechat-qr.png" />
    <EmbeddedResource Include="app.ico" LogicalName="CodexResetBar.app.ico" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="CodexResetBar.licenses.APP.txt" />
    <EmbeddedResource Include="../notices/LICENSE.NET.txt" LogicalName="CodexResetBar.licenses.NET.txt" />
    <EmbeddedResource Include="../notices/LICENSE.WindowsForms.txt" LogicalName="CodexResetBar.licenses.WindowsForms.txt" />
    <EmbeddedResource Include="../notices/THIRD-PARTY-NOTICES.NET.txt" LogicalName="CodexResetBar.licenses.ThirdParty.txt" />
  </ItemGroup>
</Project>
